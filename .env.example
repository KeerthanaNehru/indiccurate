# Copy this file to .env and fill in your own values. Never commit the real .env file.

# Optional: only needed if you hit HF rate limits on anonymous streaming, or use gated datasets.
HF_TOKEN= 

# Required for Phase 5 (synthetic data generation). Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override the default Groq model used in Phase 5.
GROQ_MODEL=llama-3.1-8b-instant
